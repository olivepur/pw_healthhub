            "preRequestScript": "",
            "testScript": "// Eigenheit der API: Fehler kommt mit Status 200.\npw.test(\"Status 200\", () => {\n  pw.expect(pw.response.status).toBe(200);\n});\npw.test(\"Bad credentials\", () => {\n  pw.expect(pw.response.body.reason).toBe(\"Bad credentials\");\n});",
