            "testScript": "pw.test(\"Status 200\", () => {\n  pw.expect(pw.response.status).toBe(200);\n});\npw.test(\"Token vorhanden\", () => {\n  pw.expect(pw.response.body.token).not.toBe(undefined);\n});\npw.env.set(\"token\", pw.response.body.token);",
